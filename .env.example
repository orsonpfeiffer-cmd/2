# Optional. With a key, Claude labels each new article once. Without it, keyword rules are used.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5          # claude-haiku-4-5 is ~5x cheaper
# PORT=3000
# DATA_DIR=./data                     # where the SQLite database lives
# FETCH_INTERVAL_MINUTES=7            # how often the server checks all sources
# CLIENT_POLL_SECONDS=120             # how often the app checks for new articles
